# Configuração S3 (RustFS local ou VM na Microsoft Azure / AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=coldwheels-imagens

# Portas do RustFS no docker-compose
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

# Limite de tamanho de upload em bytes (5 MB = 5242880)
UPLOAD_MAX_SIZE_BYTES=5242880
